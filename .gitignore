# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Data (raw/processed can be large and are regenerated by scripts, not hand-authored)
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model artifacts
models/**
!models/**/.gitkeep
!models/**/README.md

# Reports (regenerated)
reports/figures/**
reports/results/**
!reports/figures/.gitkeep
!reports/results/.gitkeep

# Env / secrets
.env
kaggle.json

# OS / editor
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
