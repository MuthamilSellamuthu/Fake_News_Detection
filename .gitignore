# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Dataset content (large, reproducible via scripts, not hand-authored) ──
datasets/raw/**
datasets/processed/**
!datasets/raw/**/.gitkeep
!datasets/processed/**/.gitkeep

# ── Legacy structure (pending removal once the new datasets/ +
#    src/data_collection/ layout below is confirmed — see chat
#    for the one-line delete command) ──
data/
src/data/

# ── Model artifacts ──────────────────────────────────────
models/**
!models/**/.gitkeep
!models/**/README.md

# ── Reports (regenerated) ────────────────────────────────
reports/figures/**
reports/results/**
!reports/figures/.gitkeep
!reports/results/.gitkeep

# ── Run artifacts ────────────────────────────────────────
logs/**
!logs/.gitkeep
outputs/**
!outputs/.gitkeep

# ── Env / secrets ────────────────────────────────────────
.env
kaggle.json

# ── OS / editor ───────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
